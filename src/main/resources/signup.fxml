<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ap404.xclone.Client.Controllers.SignupController"
      alignment="CENTER"
      spacing="400"
      prefWidth="800"
      prefHeight="600"
      stylesheets="@css/signup.css">

    <VBox alignment="CENTER" spacing="60" prefWidth="400">

        <Label text="Create your account" styleClass="title"/>

        <VBox spacing="15" alignment="CENTER">

            <TextField fx:id="nameField" promptText="Name" styleClass="name-field"/>

            <TextField fx:id="usernameField" promptText="Username" styleClass="username-field"/>

            <TextField fx:id="emailField" promptText="Email" styleClass="email-field"/>

            <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field"/>

            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="confirmPassword-field"/>

            <Button text="Create Account" onAction="#handleSignup" styleClass="signup-btn"/>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false"/>

            <Separator/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?" styleClass="login-label"/>
                <Hyperlink text="Login" onAction="#goToLogin" styleClass="login-link"/>
            </HBox>
        </VBox>
    </VBox>

    <Label text="𝕏" styleClass="logo" alignment="CENTER_RIGHT">
        <HBox.margin>
            <Insets right="50"/>
        </HBox.margin>
    </Label>
</HBox>
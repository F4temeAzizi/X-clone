<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ap404.xclone.Client.Controllers.BookmarkController"
      spacing="15"
      stylesheets="@css/main.css,@css/theme.css,@css/home.css">

    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                fx:id="scrollPane"
                hbarPolicy="NEVER"
                vbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="tweet-scroll">

        <content>
            <VBox fx:id="tweetContainer" spacing="18" VBox.vgrow="ALWAYS" styleClass="tweet-container"/>
        </content>
    </ScrollPane>

</VBox>
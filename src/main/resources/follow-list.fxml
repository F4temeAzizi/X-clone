<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ap404.xclone.Client.Controllers.FollowListController"
      spacing="0"
      VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT"
          spacing="15"
          style="-fx-padding: 15; -fx-border-color: #e6e6e6; -fx-border-width: 0 0 1 0;">

        <Button text="←"
                onAction="#goBack"
                style="-fx-background-color: transparent; -fx-font-size: 20;"/>

        <Label fx:id="titleLabel"
               text="Followers"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <Pane HBox.hgrow="ALWAYS"/>

    </HBox>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS">

        <content>
            <VBox fx:id="usersContainer"
                  spacing="10"
                  fillWidth="true">

                <padding>
                    <Insets top="10"
                            right="15"
                            bottom="10"
                            left="15"/>
                </padding>

            </VBox>
        </content>

    </ScrollPane>

</VBox>
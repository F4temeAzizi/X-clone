<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ap404.xclone.Client.Controllers.FollowListController"
      stylesheets="@css/follow-list.css"
      spacing="0"
      VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="follow-header">
        <Button fx:id="backButton" styleClass="icon-button" onAction="#goBack">
            <graphic>
                <FontIcon iconLiteral="fas-arrow-left" styleClass="icon-button"/>
            </graphic>
        </Button>
        <Label fx:id="titleLabel" text="Followers" styleClass="follow-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="follow-scroll">

        <content>
            <VBox fx:id="usersContainer" spacing="20" fillWidth="true">
                <padding>
                    <Insets top="0" right="0" bottom="0" left="0"/>
                </padding>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ap404.xclone.Client.Controllers.SignupController"
      alignment="CENTER"
      spacing="15"
      prefWidth="800"
      prefHeight="600">

    <Label text="Create your account" styleClass="title"/>

    <TextField fx:id="nameField" promptText="Name"/>

    <TextField fx:id="usernameField" promptText="Username"/>

    <TextField fx:id="emailField" promptText="Email"/>

    <PasswordField fx:id="passwordField" promptText="Password"/>

    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>

    <Button text="Create Account"/>

    <Label fx:id="errorLabel" visible="false"/>

    <HBox alignment="CENTER" spacing="5">
        <Label text="Already have an account?"/>
        <Hyperlink text="Login"/>
    </HBox>

</VBox>